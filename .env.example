# Copy this file to .env for local development.
# NEVER commit a real .env file or put live secrets in this .example file.
# In production (Render), set these as Environment Variables in the
# Render dashboard instead: Dashboard -> your service -> Environment.

# --- App ---
APP_NAME=TZ Trade Hub
NODE_ENV=development
PORT=3000

# --- ClickPesa API credentials ---
# Get these from your ClickPesa merchant dashboard.
# Docs: https://docs.clickpesa.com (verify exact endpoints before going live)
CLICKPESA_CLIENT_ID=your_clickpesa_client_id_here
CLICKPESA_API_KEY=your_clickpesa_api_key_here

# Base URL for ClickPesa's API. Use their sandbox URL while testing,
# switch to the production URL only once you've verified it in their docs.
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties

# Public HTTPS URL of THIS app, used to build ClickPesa webhook callback URLs.
# e.g. https://tz-trade-hub.onrender.com
APP_BASE_URL=http://localhost:3000
